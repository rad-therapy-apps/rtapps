{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"files": [
		"arcade",
		"build"
	],
	"scripts": {
		"dev": "pnpm build:arcade && vite dev --host 0.0.0.0 --port 5173",
		"build": "pnpm build:arcade && vite build",
		"build:arcade": "vite build -c vite.arcade.config.ts && vite build -c vite.arcade.linac-ct.config.ts",
		"dev:arcade": "vite build -c vite.arcade.config.ts --watch",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.arcade.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.56.0",
		"@rtapps/api-client": "workspace:*",
		"@sentry/sveltekit": "^11.7.0",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-image": "^3.31.4",
		"@tiptap/extension-subscript": "^3.31.4",
		"@tiptap/extension-superscript": "^3.31.4",
		"@tiptap/extension-table": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"three": "0.160.0",
		"three-ct": "npm:three@0.163.0",
		"three-linac": "npm:three@0.160.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@rtapps/schemas": "workspace:*",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.0.4",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"vitest-browser-svelte": "^3.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
