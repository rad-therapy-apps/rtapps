{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"allowJs": true,
		"checkJs": true,
		"strict": false,
		"noImplicitAny": false,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"types": []
	},
	"include": ["arcade-src/**/*.js", "arcade-src/**/*.ts"]
}
