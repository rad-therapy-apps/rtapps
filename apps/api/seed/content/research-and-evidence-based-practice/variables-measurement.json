                                {
                                  "type": "text",
                                  "text": "Equal intervals with a true zero"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Dose (Gy), setup error (mm), test scores (%)"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "title": "The Feasibility Reality Check",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Before finalizing your variables, run a feasibility check against what you can actually pull off in your available time and setting:"
                    }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Sample size:",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " quantitative studies generally need at least 30 data points per group for reasonable statistical power. Can you realistically gather that much data in your available window?"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Retrospective vs. prospective:",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " prospective studies (collecting new data as it happens) are highly susceptible to delays. Retrospective studies (using existing historical data) are usually faster and more feasible on a tight timeline."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Scope and permissions:",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " as a student researcher, you typically cannot alter a patient's actual treatment. Workflow observations, educational tools, and anonymous surveys are usually far easier to get approved than anything touching clinical care decisions."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Wrap-Up",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "You've covered independent and dependent variables, operationalization, confounding/control/moderating variables, the NOIR levels of measurement, and a practical feasibility check."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Next: your variable's level of measurement determines exactly which statistical test is valid for testing your hypothesis \u2014 that's where we're headed next."
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  },
