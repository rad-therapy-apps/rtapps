                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Stands for"
                                }
                              ]
                            }
                          ],
                          "attrs": {
                            "header": true
                          }
                        },
                        {
                          "type": "tableCell",
                          "content": [
