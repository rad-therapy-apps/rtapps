    "pages": [
      {
        "title": "No SPSS Required",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "This module traditionally requires access to IBM SPSS through a university VDI or portal login. Here, you'll run the exact same five analyses using "
                    },
                    {
                      "type": "text",
                      "text": "RTApps Statistics Studio",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " \u2014 a free, in-browser statistics tool built for this course. No installation, no license, no VDI wait times. Your data never leaves your browser."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The statistical reasoning is identical either way \u2014 you're still forming hypotheses, choosing the right test, and interpreting output. Only the click-path changes."
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
