                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Educational example"
                                }
                              ]
                            }
                          ],
                          "attrs": {
                            "header": true
                          }
                        }
                      ]
                    },
                    {
