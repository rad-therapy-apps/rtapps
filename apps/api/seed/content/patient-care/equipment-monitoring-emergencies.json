                  "content": [
                    {
                      "type": "text",
                      "text": "In two-person adult CPR, what compression-to-breath ratio is used?"
                    }
                  ]
                }
              ]
            },
            "options": [
              "15:2",
              "30:2",
              "5:1"
            ],
            "answer": 1,
            "explanation": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Two-person adult CPR still uses a 30:2 ratio \u2014 it's the child/infant two-person ratio that changes to 15:2."
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Other emergencies you may encounter \u2014 allergic reactions, seizures, diabetic reactions, and physical trauma \u2014 all share the same first steps: stay with the patient, call for help, and don't attempt treatment beyond your scope."
                    }
                  ]
                }
              ]
            }
          }
