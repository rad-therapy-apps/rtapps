      {
        "title": "Measuring & Understanding Vital Signs",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Vital signs indicate essential body functions."
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Key Vital Signs:"
                    }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Weight:",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " Document accurately; crucial for some calculations."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Temperature:",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " Oral normal: 97.0-99.0\u00b0F (36.1-37.2\u00b0C). Fever can indicate infection."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Pulse (Heart Rate):",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " Normal adult: 60-100 bpm. Note rate, rhythm, strength."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Respiration Rate:",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " Normal adult: 12-20 breaths/min. Note rate, depth, effort."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Blood Pressure:",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " Normal adult: <120/80 mmHg. Use correct cuff size."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Report significant deviations. Clean equipment properly."
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "knowledge_check",
            "key": "q_page3_1_ans",
