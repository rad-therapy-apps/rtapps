    "title": "Patient Care",
    "order": 4
  },
  "lesson": {
    "slug": "clinical-objectives",
    "title": "Foundations of Patient Care",
    "order": 0,
    "pages": [
      {
        "title": "The Compassionate & Competent Therapist",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Purpose: Why This Matters This lesson introduces fundamental patient care skills crucial for Radiation Therapists, focusing on safety, communication, and basic clinical procedures to ensure a positive treatment experience."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Task: What You Will Do Learn about patient identification, communication, vital signs, safe patient handling, oxygen administration, infection control, and BLS/AED overview."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Criteria for Success Understand steps for patient ID, vital signs importance, safe transfer principles, O2 basics, universal precautions, and BLS/AED components."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Your care significantly impacts the patient's experience."
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Patient Identification, Instruction & Communication",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Accurate patient identification and clear communication are paramount."
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Accurate Patient Identification:"
                    }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Always use at least "
                            },
                            {
                              "type": "text",
                              "text": "two patient identifiers",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " (e.g., full name, DOB, MRN)."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Actively involve the patient: ask them to state their name and DOB."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Clear Communication:"
                    }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Introduce yourself clearly (name and title)."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Explain procedures in simple terms."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Verify understanding and encourage questions. Practice active listening."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "knowledge_check",
            "key": "q_page2_1_ans",
            "stem": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Quick Check: Minimum patient identifiers to use?"
                    }
                  ]
                }
              ]
            },
            "options": [
              "One",
              "Two",
              "Three"
            ],
            "answer": 0,
