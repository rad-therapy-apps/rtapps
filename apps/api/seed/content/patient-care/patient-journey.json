                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "RTTs also observe patients daily and report concerns."
                    }
                  ]
                }
              ]
            }
          },
