                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " phase."
                    }
                  ]
                },
                {
                  "type": "heading",
                  "attrs": {
                    "level": 4
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Key Aspects:"
                    }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Scheduled Appointments:",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " Regular visits with the Radiation Oncologist."
