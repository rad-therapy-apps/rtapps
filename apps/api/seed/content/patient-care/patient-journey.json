                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Coordination of Care:",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " With other physicians involved in the patient's care."
