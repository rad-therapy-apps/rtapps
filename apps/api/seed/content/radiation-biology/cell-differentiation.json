                              "content": [
                                {
                                  "type": "text",
                                  "text": "Radiosensitivity"
                                }
                              ]
                            }
                          ],
                          "attrs": {
                            "header": true
                          }
                        }
                      ]
                    },
                    {
                      "type": "tableRow",
                      "content": [
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "VIM",
                                  "marks": [
                                    {
                                      "type": "bold"
                                    }
                                  ]
                                },
                                {
                                  "type": "hardBreak"
                                },
                                {
                                  "type": "text",
                                  "text": "(Vegetative Intermitotic)"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Divide regularly and rapidly, undifferentiated, don't differentiate between divisions"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Type A spermatogonia, erythroblasts, crypt cells, basal cells"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Extremely high"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "tableRow",
                      "content": [
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "DIM",
                                  "marks": [
                                    {
                                      "type": "bold"
                                    }
                                  ]
                                },
                                {
                                  "type": "hardBreak"
                                },
                                {
                                  "type": "text",
                                  "text": "(Differentiating Intermitotic)"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Actively divide, more differentiated than VIM cells, differentiate between divisions"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Intermediate spermatogonia, myelocytes"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "High"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "VIM cells are the most radiosensitive cell population in the body \u2014 rapidly dividing, undifferentiated cells with short life spans."
                    }
                  ]
                }
              ]
            }
          }
        ]
