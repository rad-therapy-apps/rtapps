                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Interaction"
                                }
                              ]
                            }
                          ],
                          "attrs": {
                            "header": true
                          }
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Energy range"
                                }
                              ]
                            }
                          ],
                          "attrs": {
                            "header": true
                          }
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Interacts with"
                                }
                              ]
                            }
                          ],
                          "attrs": {
                            "header": true
                          }
                        }
                      ]
                    },
                    {
                      "type": "tableRow",
                      "content": [
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Coherent (classical) scattering"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "< 10 keV"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Whole atom"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "tableRow",
                      "content": [
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Photoelectric effect"
                                }
                              ]
                            }
                          ]
                        },
