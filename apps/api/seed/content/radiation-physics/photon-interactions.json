                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "\u2265 10 MeV"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
