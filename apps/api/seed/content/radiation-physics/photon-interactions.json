                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Compton scattering"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "~40\u2013150 kVp, dominant in megavoltage range"
                                }
                              ]
