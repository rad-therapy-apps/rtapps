  "lesson": {
    "slug": "abdomen",
    "title": "Sectional Anatomy: Abdomen",
    "order": 0,
    "pages": [
      {
        "title": "The Abdomen \u2014 Boundaries and Levels",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "IV and oral contrast",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " sharpen organ and vessel borders on abdominal CT. Vertebral levels orient you: diaphragm ~T8\u2013T10, GE junction ~T10\u2013T11, pancreatic head ~L1\u2013L2, kidneys ~T12\u2013L3, and the adult cord ending at the "
                    },
                    {
                      "type": "text",
                      "text": "conus medullaris ~L1\u2013L2",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    }
                  ]
                },
                {
                  "type": "callout",
                  "attrs": {
                    "kind": "key-principle"
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A quick orientation rule that holds on every axial slice: the "
                        },
                        {
                          "type": "text",
                          "text": "aorta",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": " sits anterior/left of the spine, with the "
                        },
                        {
                          "type": "text",
                          "text": "inferior vena cava immediately to its right",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Abdominal Organs in 3D",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Rotate this abdominal model to place the major organs relative to one another before reading them on cross-section."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": []
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Interactive abdominal anatomy. Locate the liver (right upper quadrant), spleen (left upper quadrant), stomach, pancreas draped across the midline, kidneys posteriorly, and the great vessels."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "3D model: \"Abdomen Anatomy\" by CaitlynnH (sketchfab.com/CaitlynnH), CC-BY-4.0."
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "knowledge_check",
            "key": "a_p2_1",
            "stem": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "In which quadrant is the spleen located?"
                    }
                  ]
                }
              ]
            },
            "options": [
              "Right upper quadrant",
              "Left upper quadrant",
              "Right lower quadrant"
            ],
            "answer": 1,
            "explanation": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The spleen sits in the left upper quadrant, posterolateral to the stomach; the liver occupies the right upper quadrant."
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Peritoneal vs. Retroperitoneal",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "A core abdominal distinction is which organs sit "
                    },
                    {
                      "type": "text",
                      "text": "within",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " the peritoneal cavity versus "
                    },
                    {
                      "type": "text",
                      "text": "behind",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " it \u2014 it explains motion, spread patterns, and approach."
                    }
                  ]
                },
                {
                  "type": "table",
                  "content": [
                    {
                      "type": "tableRow",
                      "content": [
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Retroperitoneal"
                                }
                              ]
                            }
                          ],
                          "attrs": {
                            "header": true
                          }
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Peritoneal"
                                }
                              ]
                            }
                          ],
                          "attrs": {
                            "header": true
                          }
                        }
                      ]
                    },
                    {
                      "type": "tableRow",
                      "content": [
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Kidneys & adrenals, ureters"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Liver, spleen, stomach"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "tableRow",
                      "content": [
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Pancreas (mostly), duodenum (2nd\u20134th parts)"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Gallbladder"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "tableRow",
                      "content": [
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Aorta & IVC; ascending/descending colon"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "tableCell",
                          "content": [
                            {
                              "type": "paragraph",
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Transverse colon, jejunum/ileum"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "knowledge_check",
            "key": "a_p3_1",
            "stem": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Which of these is a retroperitoneal organ?"
                    }
                  ]
                }
              ]
            },
            "options": [
              "Kidney",
              "Spleen",
              "Gallbladder"
            ],
            "answer": 0,
            "explanation": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The kidneys (with adrenals, pancreas, duodenum, aorta, and IVC) are retroperitoneal; the spleen and gallbladder are intraperitoneal."
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Nodal Anatomy and the Great Vessels",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Abdominal nodal chains follow the "
                    },
                    {
                      "type": "text",
                      "text": "aorta and IVC",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " (para-aortic / paracaval) and the major branch vessels \u2014 the same landmarks that orient organ contouring. Review the shared thoracoabdominal nodal model:"
                    }
                  ]
                },
                {
                  "type": "callout",
                  "attrs": {
                    "kind": "key-principle"
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Para-aortic and paracaval nodal stations track the great vessels anterior to the spine. Explore nodal anatomy in the workbook's "
                        },
                        {
                          "type": "text",
                          "text": "3D lymphatics model"
                        },
                        {
                          "type": "text",
                          "text": "."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "knowledge_check",
            "key": "a_p4_1",
            "stem": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Abdominal para-aortic nodes are described relative to which structure?"
                    }
                  ]
                }
              ]
            },
            "options": [
              "The aorta",
              "The gallbladder",
              "The spleen"
            ],
            "answer": 0,
            "explanation": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Para-aortic (and paracaval) nodal stations follow the aorta and IVC anterior to the spine \u2014 the reason those vessels are such important orientation landmarks."
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Anatomic Verification in the Abdomen",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Abdominal targets combine "
                    },
                    {
                      "type": "text",
                      "text": "respiratory motion",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " with "
                    },
                    {
                      "type": "text",
                      "text": "variable bowel/stomach filling",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", so verification is organ- and target-focused."
                    }
                  ]
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "CBCT soft-tissue matching",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " to the organ (liver dome, kidney) rather than bone alone."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Motion management: "
                            },
                            {
                              "type": "text",
                              "text": "4D-CT/ITV, breath-hold, gating, or abdominal compression",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": "."
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Fiducial markers",
                              "marks": [
                                {
                                  "type": "bold"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": " (liver, pancreas) provide a visible surrogate on daily imaging."
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "knowledge_check",
            "key": "a_p5_1",
            "stem": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Why are fiducial markers often used for liver or pancreas verification?"
                    }
                  ]
                }
              ]
            },
            "options": [
              "The soft-tissue target may be hard to see and moves relative to bone, so a radio-opaque marker gives a reliable surrogate",
              "They increase electron density for dose calculation"
            ],
            "answer": 0,
            "explanation": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Low soft-tissue contrast plus respiratory/filling motion makes some abdominal targets hard to localize; fiducials give a clear, trackable surrogate."
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      {
        "title": "Wrap-Up",
        "blocks": [
          {
            "type": "rich_text",
            "body": {
