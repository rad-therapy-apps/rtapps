# What this file does: template for the production/test environment file consumed by
#   infra/compose.prod.yaml (and infra/compose.tunnel.yaml) via `--env-file`.
# Used here and why: every variable those files reference, with a placeholder value and
#   a one-line comment — no real secrets are ever committed here. Per ADR-0005, secrets
#   live only in /opt/rtapps/.env on the VM (mode 600); the runbook (docs/06-operations.md,
#   Task 12) tells the owner to copy this file there and fill in real values by hand.
# How it fits the project: docs/03-architecture.md §3, ADR-0005 ("Secrets live only in
#   /opt/rtapps/.env on the VM, never in CI variables beyond the SSH key and GHCR token").
#   The `test` VM uses this same template with test-specific values.
# Depends on: nothing (hand-edited after copying).
# Used by: infra/compose.prod.yaml, infra/compose.tunnel.yaml (`--env-file`), the
#   Makefile's `prod-config` target (validates that this exact file's placeholder values
#   parse as valid compose config).

# --- Images (ADR-0005: built in CI, pulled from GHCR, never built on the VM) ---
IMAGE_REPO=ghcr.io/rad-therapy-apps/rtapps # GHCR repo prefix; -api/-web/-backup are appended
IMAGE_TAG= # git SHA to deploy; left empty here, set by the deploy workflow

# --- Postgres ---
POSTGRES_USER=rtapps # database role the api and backup containers connect as
POSTGRES_PASSWORD=replace-me # generate a strong random password before deploying
POSTGRES_DB=rtapps # database name
PGDATA_PATH=pgdata # named volume by default; set to a host path to use the mounted block volume
DATABASE_URL=postgresql+asyncpg://rtapps:replace-me@db:5432/rtapps # keep in sync with the three vars above

# --- API ---
SESSION_SECRET=replace-with-64-random-chars # cookie-signing secret, e.g. `openssl rand -hex 32`
PUBLIC_ORIGIN=https://rt.example.edu # public URL students/staff use; checked against the Origin header
GOOGLE_CLIENT_ID= # optional: Google OAuth client id, blank disables Google sign-in
GOOGLE_CLIENT_SECRET= # optional: Google OAuth client secret
SENTRY_DSN= # optional: error tracking DSN read by both api and web (server-side only), blank disables Sentry (errors only, no tracing)

# --- Object storage (external S3-compatible bucket — R2/OCI; no `storage` service in prod) ---
S3_ENDPOINT=https://replace-with-bucket-endpoint.example # S3-compatible API endpoint for the media bucket
S3_ACCESS_KEY=replace-me # access key for S3_ENDPOINT
S3_SECRET_KEY=replace-me # secret key for S3_ENDPOINT
S3_BUCKET=rtapps-media # bucket name for uploaded media

# --- Proxy (infra/Caddyfile.prod) ---
SITE_ADDRESS=:80 # a real hostname (e.g. rt.example.edu) for automatic TLS, or :80 behind the tunnel

# --- Backup (infra/backup) ---
BACKUP_BUCKET=rtapps-backups # bucket for nightly encrypted pg_dump uploads (may be S3_ENDPOINT's account)
BACKUP_AGE_RECIPIENT=age1replace-with-a-real-age-public-key # `age` public key backups are encrypted to
BACKUP_RETENTION_DAYS=30 # days of backups kept before old ones are pruned
BACKUP_HOUR_UTC=03 # hour (UTC, 00-23) the nightly backup runs

# --- Cloudflare Tunnel (only read when infra/compose.tunnel.yaml is also applied) ---
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflared-tunnel-token # token for `cloudflared tunnel run`
